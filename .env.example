# Copy this file to .env before starting the runtime stack.
# Never commit .env.

# Public URL served only through Tailscale Serve.
APP_ORIGIN=https://your-server.your-tailnet.ts.net
TAILSCALE_AUTH_REQUIRED=true
TAILSCALE_ALLOWED_LOGIN=your-tailnet-login@example.com

# Filesystem roots inside the containers.
MEDIA_ROOT=/media
MAX_UPLOAD_BYTES=21474836480
UPLOAD_HOOK_SECRET=replace-with-a-separate-long-random-value

# PostgreSQL and Redis are private Compose-network services.
POSTGRES_DB=gm_media
POSTGRES_USER=gm_media
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://gm_media:replace-with-a-long-random-value@postgres:5432/gm_media
REDIS_URL=redis://redis:6379/0

# Editor brain. Connect ChatGPT Pro with the documented local enrollment and
# scripts/import-chatgpt.sh transfer. Raw
# originals are never sent; hybrid mode shares transcripts and contact sheets.
AI_MODE=hybrid
AI_ALLOW_DRAFT_COPY=false
CHATGPT_MODEL=gpt-6.1-sol

# Paid fallback is never used unless this flag is explicitly changed to true.
AI_GATEWAY_FALLBACK_ENABLED=false
AI_GATEWAY_MODEL=openai/gpt-6.1-sol
AI_GATEWAY_API_KEY=
