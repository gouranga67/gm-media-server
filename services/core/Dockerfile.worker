FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fonts-dejavu-core \
        tesseract-ocr \
        tesseract-ocr-eng \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-worker.txt ./
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir --requirement requirements.txt --requirement requirements-worker.txt

ARG WHISPER_MODEL_REPOSITORY=Systran/faster-whisper-small
ARG WHISPER_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${WHISPER_MODEL_REPOSITORY}', revision='${WHISPER_MODEL_REVISION}', local_dir='/models/faster-whisper-small')"

ARG VISUAL_MODEL_REPOSITORY=openai/clip-vit-base-patch32
ARG VISUAL_MODEL_REVISION=c7244be81152024ce0e99ac8d2e373a8953d9f9a
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${VISUAL_MODEL_REPOSITORY}', revision='${VISUAL_MODEL_REVISION}', local_dir='/models/clip-vit-base-patch32', allow_patterns=['config.json','preprocessor_config.json','tokenizer_config.json','special_tokens_map.json','tokenizer.json','vocab.json','merges.txt','pytorch_model.bin'])"

ARG SPEECH_ALIGNMENT_MODEL_REVISION=22aad52d435eb6dbaf354bdad9b0da84ce7d6156
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='facebook/wav2vec2-base-960h', revision='${SPEECH_ALIGNMENT_MODEL_REVISION}', local_dir='/models/wav2vec2-base-960h', allow_patterns=['README.md','config.json','preprocessor_config.json','tokenizer_config.json','special_tokens_map.json','vocab.json','model.safetensors'])"

ENV HF_HOME=/tmp/huggingface
ENV SPEECH_ALIGNMENT_MODEL_REVISION=${SPEECH_ALIGNMENT_MODEL_REVISION}

COPY requirements-visual.txt ./
RUN pip install --no-cache-dir --requirement requirements-visual.txt

# Small MIT-licensed face detector; pin both repository revision and file hash.
RUN python -c "import urllib.request, hashlib, pathlib; base='https://media.githubusercontent.com/media/opencv/opencv_zoo/48b10fa505aeb51fbd127fc60a5c660040e823b7/models/face_detection_yunet/'; data=urllib.request.urlopen(base+'face_detection_yunet_2023mar.onnx', timeout=60).read(); assert hashlib.sha256(data).hexdigest()=='8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'; pathlib.Path('/models/face_detection_yunet_2023mar.onnx').write_bytes(data); license=urllib.request.urlopen('https://raw.githubusercontent.com/opencv/opencv_zoo/48b10fa505aeb51fbd127fc60a5c660040e823b7/models/face_detection_yunet/LICENSE', timeout=60).read(); assert hashlib.sha256(license).hexdigest()=='c83b8120c50ccbd4c4f96edf53141bdd566ebb8f8e9227e415326aa1b1aba958'; pathlib.Path('/models/YuNet-LICENSE').write_bytes(license)"

RUN groupadd --gid 10001 gmmedia \
    && useradd --uid 10001 --gid gmmedia --create-home --shell /usr/sbin/nologin gmmedia \
    && chown -R gmmedia:gmmedia /models

COPY --chown=gmmedia:gmmedia app ./app
COPY --chown=gmmedia:gmmedia migrations ./migrations

USER gmmedia
